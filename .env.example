YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CHANNEL_ID=your-youtube-channel-id-here
PORT=3000
USDA_API_KEY=your-usda-key-here
SERPAPI_KEY=your-serpapi-key-here
KLAVIYO_PRIVATE_API_KEY=your-klaviyo-private-api-key-here
# Klaviyo event profile:
# - free (default): only essential lifecycle/retention events
# - all: send every event wired in backend routes
# - none: disable Klaviyo event emission
# KLAVIYO_EVENT_PROFILE=free
# Optional strict override list (comma-separated). If set, only these events send:
# KLAVIYO_ENABLED_EVENTS=Account Created,Password Reset Requested,Message Received
# Event payloads include rendered template fields like:
# ode_email_subject, ode_email_preheader, ode_email_html, ode_email_text
# Legacy alias also supported by server code:
# KLAVIYOPRIVATEAPIKEY=your-klaviyo-private-api-key-here
# Additional aliases also supported:
# KLAVIYO_API_KEY=your-klaviyo-private-api-key-here
# CHATSFULLACCESS=your-klaviyo-private-api-key-here
# Optional flow automation settings:
# KLAVIYO_FLOW_BOOTSTRAP_EMAIL=you@yourdomain.com
# KLAVIYO_FLOW_NAME_PREFIX=ODE -
# KLAVIYO_FLOW_PROTOTYPE_ID=
# Public site URL for password reset links and email CTAs:
# APP_BASE_URL=https://STRYVE.up.railway.app
# Password reset link expiry in minutes:
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Neon / Postgres (recommended: paste the full Neon "Node.js" connection string here)
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Alternatively, use individual env vars (matches Neon's Node guide)
# PGHOST='[neon_hostname]'
# PGDATABASE='[dbname]'
# PGUSER='[user]'
# PGPASSWORD='[password]'
# PGPORT=5432

# Auth (sessions stored in Neon)
# SESSION_TTL_DAYS=30
# SESSION_COOKIE_NAME=sid
# COOKIE_SECURE=0

# Training import OCR backend (PaddleOCR)
# TRAINING_IMPORT_OCR_PYTHON=python3
# TRAINING_IMPORT_OCR_TIMEOUT_MS=8000
# TRAINING_IMPORT_OCR_MAX_IMAGE_BYTES=4000000
# Optional OCR.space fallback key (defaults to free demo key "helloworld"):
# OCRSPACE_API_KEY=helloworld

# Google OAuth (optional)
# Create credentials in Google Cloud Console and set an "Authorized redirect URI" to:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Admin dashboard (keep these out of client-side JS)
# ADMIN_USERNAME=Mason0205
# ADMIN_PASSCODE=4digitcode
# ADMIN_SESSION_TTL_DAYS=7

# ── Scoring Engine v2 (SCORING_ENGINE_V2) ──────────────────────────────────
# Master feature flag for the server-side scoring engine. Leave OFF until the
# engine has been reviewed; the owner flips it to true on Railway. See DEPLOYMENT.md.
# SCORING_ENGINE_V2=false
# Fallback timezone for the health day-boundary when a user has no stored timezone.
# DEFAULT_TZ=America/New_York
# Strava OAuth (activity:read already returns HR/distance/type — no extra scope).
# STRAVA_CLIENT_ID=your-strava-client-id
# STRAVA_CLIENT_SECRET=your-strava-client-secret
# Fitbit OAuth. FITBIT_SCOPES MUST include 'heart' for VO2max / resting-HR cardio
# inputs — and the Fitbit app registration must also request 'heart' or prod 403s.
# FITBIT_CLIENT_ID=your-fitbit-client-id
# FITBIT_CLIENT_SECRET=your-fitbit-client-secret
# FITBIT_SCOPES=activity sleep profile heart
# Public base URL for OAuth callbacks (Railway public domain in prod, localhost locally).
# PUBLIC_BASE_URL=https://STRYVE.up.railway.app
# HEALTH_OAUTH_SECRET=change-me-in-prod
